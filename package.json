{
  "name": "@featureflip/node",
  "version": "2.20.0",
  "description": "Node.js server SDK for Featureflip",
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "feature-management",
    "featureflip",
    "nodejs",
    "server",
    "typescript",
    "sdk",
    "nestjs"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/canopy-labs/featureflip-node.git"
  },
  "homepage": "https://featureflip.io/docs/sdks/nodejs/",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./nestjs": {
      "types": "./dist/nestjs/index.d.ts",
      "import": "./dist/nestjs/index.mjs",
      "require": "./dist/nestjs/index.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@featureflip/js": "^2.20.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.60.1",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/testing": "^12.5.1",
    "@types/node": "^26.6.6",
    "@typescript/typescript6": "^6.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "lodash": ">=4.17.25"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    }
  }
}
